# Copy to .env and fill in. Never commit .env or the private key.

# Server
PORT=3001
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data/dashboard.sqlite

# Public URL of the web app (used for OAuth redirects and CORS)
APP_URL=http://localhost:5173

# GitHub App (created under GitHub Settings > Developer settings > GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Path to the downloaded private key (.pem), kept outside version control
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.private-key.pem

# Comma-separated GitHub usernames allowed to sign in
ALLOWED_GITHUB_USERS=
